# 复用本机 lark-cli 已连接的机器人，不在项目中保存飞书密钥。
LARK_CLI_BIN=lark-cli

# 可选：lark-cli 有多个 profile 时填写；留空使用当前 profile。
LARK_CLI_PROFILE=

# 回答一张卡片后，等待多少分钟再自动推送下一张。
PUSH_INTERVAL_MINUTES=5

# 学习卡未回答时，每隔多少分钟提醒一次；不会创建新的学习卡。
PENDING_REMINDER_MINUTES=30
TIMEZONE=Asia/Shanghai

# 可选：只允许这些飞书 open_id 使用机器人，逗号分隔。留空表示应用可用范围内的用户都可使用。
ALLOWED_OPEN_IDS=

# 每次点击“认识”后的复习间隔（天），可按需调整。
KNOWN_INTERVALS_DAYS=1,3,7,14,30,60
UNKNOWN_RETRY_MINUTES=20

DATABASE_PATH=./data/pte-learning.db
LOG_LEVEL=info
