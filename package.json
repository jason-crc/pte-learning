{
  "name": "pte-fragment-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Feishu bot that turns spare moments into PTE vocabulary reviews.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jason-crc/pte-learning.git"
  },
  "homepage": "https://github.com/jason-crc/pte-learning#readme",
  "bugs": {
    "url": "https://github.com/jason-crc/pte-learning/issues"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "send:now": "tsx src/cli.ts send-now",
    "stats": "tsx src/cli.ts stats"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.18.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.2"
  }
}
